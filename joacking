// === CALENDARIO ===
function renderCalendar() {
  const container = document.getElementById('calendarDays');
  const title = document.getElementById('calendarMonth');
  if (!container || !title) return;

  title.textContent = currentCalendarDate.toLocaleString('es-ES', { month: 'long', year: 'numeric' });

  container.innerHTML = '';
  const year = currentCalendarDate.getFullYear();
  const month = currentCalendarDate.getMonth();

  const firstOfMonth = new Date(year, month, 1);
  const startDay = firstOfMonth.getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();

  const totalSlots = startDay + daysInMonth;
  const totalCells = Math.ceil(totalSlots / 7) * 7;

  const today = new Date();
  today.setHours(0, 0, 0, 0);

  for (let i = 0; i < totalCells; i++) {
    const dayNum = i - startDay + 1;
    const cell = document.createElement('div');
    cell.className = 'calendar-day';

    const cellDate = new Date(year, month, dayNum);

    if (dayNum < 1 || dayNum > daysInMonth) {
      cell.classList.add('other-month', 'disabled');
      cell.textContent = cellDate.getDate();
      cell.title = 'No disponible';
    } else {
      cell.textContent = dayNum;

      const cellCopy = new Date(year, month, dayNum);
      cellCopy.setHours(0, 0, 0, 0);

      if (cellCopy < today) {
        cell.classList.add('disabled');
        cell.title = 'Fecha pasada';
      } else {
        cell.addEventListener('click', () => {
          document.querySelectorAll('.calendar-day').forEach(d => d.classList.remove('selected'));
         
 
          cell.classList.add('selected');

          selectedDate = new Date(year, month, dayNum);
          document.getElementById('bookingDate').value = formatISOLocal(selectedDate);
          updateAvailableTimes();
          updateBookingSummary();
        });
      }

      if (isSameDay(cellDate, new Date())) {
        cell.classList.add('today');
      }

      if (selectedDate && isSameDay(cellDate, selectedDate)) {
        cell.classList.add('selected');
      }
    }

    container.appendChild(cell);
  }
}

function previousMonth() {
  currentCalendarDate = new Date(currentCalendarDate.getFullYear(), currentCalendarDate.getMonth() - 1, 1);
  renderCalendar();
}

function nextMonth() {
  currentCalendarDate = new Date(currentCalendarDate.getFullYear(), currentCalendarDate.getMonth() + 1, 1);
  renderCalendar();
}

// === DISPONIBILIDAD DE HORAS ===
function updateAvailableTimes() {
  const select = document.getElementById('bookingTime');
  if (!select) return;

  const appointments = JSON.parse(localStorage.getItem('loockingAppointments')) || [];
  const dateIso = document.getElementById('bookingDate').value;

  if (!selectedBarberId || !dateIso) {
    Array.from(select.options).forEach(opt => {
      if (opt.value === '') return;
      opt.disabled = true;
      opt.classList.add('text-muted');
      opt.title = !selectedBarberId ? 'Selecciona personal primero' : 'Selecciona fecha primero';
    });
    return;
  }

  Array.from(select.options).forEach(opt => {
    opt.disabled = false;
    opt.classList.remove('text-muted');
    opt.title = '';
    if (opt.dataset.originalText) {
      opt.textContent = opt.dataset.originalText;
    } else {
      opt.dataset.originalText = opt.textContent;
    }
  });

  appointments.forEach(a => {
    if (parseInt(a.barberId) === parseInt(selectedBarberId) && a.date === dateIso) {
      const opt = Array.from(select.options).find(o => o.value === a.time);
      if (opt) {
        opt.disabled = true;
        opt.title = `Ocupado por ${a.clientName}`;
        opt.classList.add('text-muted');
        if (!opt.textContent.includes('(Ocupado)')) opt.textContent = opt.textContent + ' (Ocupado)';
      }
    }
  });

  const cur = select.value;
  if (cur && select.querySelector(`option[value="${cur}"]`)?.disabled) {
    select.value = '';
  }
  updateBookingSummary();
}

function updateBookingSummary() {
  const services = JSON.parse(localStorage.getItem('loockingServices')) || [];
  const barbers = JSON.parse(localStorage.getItem('loockingBarbers')) || [];
  
  const selectedServiceNames = services
    .filter(s => selectedServices.includes(s.id))
    .map(s => s.name)
    .join(', ') || '—';
  
  const barber = barbers.find(b => b.id === selectedBarberId);
  const dateText = selectedDate ? new Date(selectedDate).toLocaleDateString('es-ES') : '—';
  const time = document.getElementById('bookingTime')?.value || '—';

  const summary = document.getElementById('bookingSummary');
  if (summary) {
    summary.textContent = `${selectedServiceNames} con ${barber?.name || 'Personal'} — ${dateText} ${time !== '—' ? ('| ' + time) : ''}`;
  }
}

// === PASOS DEL FORMULARIO ===

function goToStep(step) {
  if (currentStep === 1) {
    const name = document.getElementById('clientName').value.trim();
    const phone = document.getElementById('clientPhone').value.trim();
    const email = document.getElementById('clientEmail').value.trim();
    
    if (!name || !phone || !email) {
      showToast('Completa todos los campos', 'error');
      return;
    }
  }
  
  if (currentStep === 2 && selectedServices.length === 0) {
    showToast('Selecciona al menos un servicio', 'error');
    return;
  }

  if (currentStep === 3 && !selectedBarberId) {
    showToast('Selecciona personal', 'error');
    return;
  }

  currentStep = step;
  document.querySelectorAll('.booking-form-step').forEach(s => s.style.display = 'none');
  const target = document.querySelector(`.booking-form-step[data-step="${step}"]`);
  if (target) target.style.display = 'block';

  document.querySelectorAll('.booking-step').forEach((s, i) => {
    s.classList.remove('active', 'completed');
    if (i + 1 < step) s.classList.add('completed');
    if (i + 1 === step) s.classList.add('active');
  });

  if (step === 4) {
    currentCalendarDate = currentCalendarDate || new Date();
    renderCalendar();
    updateAvailableTimes();
    updateBookingSummary();
  }
}

