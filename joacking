// === CITAS RECIENTES ===
function renderRecentAppointments() {
  const appointments = JSON.parse(localStorage.getItem('loockingAppointments')) || [];
  const tbody = document.getElementById('recentAppointmentsTbody');
  
  if (!tbody) return;

  if (appointments.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No hay citas registradas</td></tr>';
    return;
  }

  const services = JSON.parse(localStorage.getItem('loockingServices')) || [];
  const barbers = JSON.parse(localStorage.getItem('loockingBarbers')) || [];
  
  const recent = appointments.slice(-5).reverse();
  tbody.innerHTML = '';
  
  recent.forEach(a => {
    const barber = barbers.find(b => b.id === a.barberId);
    const serviceNames = (a.serviceIds || [])
      .map(id => {
        const service = services.find(s => s.id === id);
        return service ? service.name : '';
      })
      .filter(Boolean)
      .join(', ');

    const tr = document.createElement('tr');
    const statusClass = a.status === 'confirmada' ? 'success' : 'danger';
    
    tr.innerHTML = `
      <td>${a.clientName}</td>
      <td>${barber ? barber.name : 'N/A'}</td>
      <td>${serviceNames || 'N/A'}</td>
      <td>${new Date(a.date).toLocaleDateString('es-ES')}</td>
      <td>${a.time}</td>
      <td><span class="badge bg-${statusClass}">${a.status}</span></td>
    `;
    tbody.appendChild(tr);
  });
}

// === ACTUALIZAR DASHBOARD ===
function updateDashboard() {
  const appointments = JSON.parse(localStorage.getItem('loockingAppointments')) || [];
  const clients = JSON.parse(localStorage.getItem('loockingClients')) || [];
  const services = JSON.parse(localStorage.getItem('loockingServices')) || [];
  const barbers = JSON.parse(localStorage.getItem('loockingBarbers')) || [];

  const today = new Date();
  today.setHours(0, 0, 0, 0);

  const todayAppointments = appointments.filter(a => {
    const apptDate = new Date(a.date);
    apptDate.setHours(0, 0, 0, 0);
    return apptDate.getTime() === today.getTime() && a.status === 'confirmada';
  }).length;

  const confirmedAppointments = appointments.filter(a => a.status === 'confirmada').length;
  
  // Calcular ingresos
  const totalRevenue = appointments
    .filter(a => a.status === 'confirmada')
    .reduce((sum, a) => {
      const serviceTotal = (a.serviceIds || []).reduce((ssum, sid) => {
        const service = services.find(s => s.id === sid);
        return ssum + (service ? service.price : 0);
      }, 0);
      return sum + serviceTotal;
    }, 0);

  const el = document.getElementById('totalAppointments');
  if (el) el.textContent = confirmedAppointments;
  
  const el2 = document.getElementById('todayAppointments');
  if (el2) el2.textContent = todayAppointments;
  
  const el3 = document.getElementById('totalRevenue');
  if (el3) el3.textContent = totalRevenue.toLocaleString();
  
  const el4 = document.getElementById('totalClients');
  if (el4) el4.textContent = clients.length;
  
  const el5 = document.getElementById('activeStaff');
  if (el5) el5.textContent = barbers.length;
  
  const el6 = document.getElementById('staffBreakdown');
  if (el6) el6.textContent = `${barbers.length} barbero${barbers.length !== 1 ? 's' : ''}`;

  renderRecentAppointments();
}

// === GRÁFICOS DEL DASHBOARD ===
function initDashboardCharts() {
  const appointments = JSON.parse(localStorage.getItem('loockingAppointments')) || [];
  const services = JSON.parse(localStorage.getItem('loockingServices')) || [];
  const barbers = JSON.parse(localStorage.getItem('loockingBarbers')) || [];

  // Destruir gráficos previos
  Object.values(charts).forEach(chart => {
    if (chart && typeof chart.destroy === 'function') {
      chart.destroy();
    }
  });
  charts = {};

  // Gráfico 1: Citas por Barbero
  const ctx1 = document.getElementById('appointmentsByBarberChart');
  if (ctx1) {
    const barberCounts = {};
    barbers.forEach(b => {
      barberCounts[b.id] = appointments.filter(a => a.barberId === b.id && a.status === 'confirmada').length;
    });

    charts.appointmentsByBarber = new Chart(ctx1, {
      type: 'doughnut',
      data: {
        labels: barbers.map(b => b.name),
        datasets: [{
          data: barbers.map(b => barberCounts[b.id] || 0),
          backgroundColor: ['#667eea', '#764ba2', '#f093fb'],
          borderColor: 'white',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom'
          }
        }
      }
    });
  }

  // Gráfico 2: Servicios Más Solicitados
  const ctx2 = document.getElementById('topServicesChart');
  if (ctx2) {
    const serviceCounts = {};
    appointments.forEach(a => {
      (a.serviceIds || []).forEach(sid => {
        serviceCounts[sid] = (serviceCounts[sid] || 0) + (a.status === 'confirmada' ? 1 : 0);
      });
    });

    const topServices = services
      .map(s => ({
        name: s.name,
        count: serviceCounts[s.id] || 0
      }))
      .sort((a, b) => b.count - a.count)
      .slice(0, 5);

    charts.topServices = new Chart(ctx2, {
      type: 'bar',
      data: {
        labels: topServices.map(s => s.name),
        datasets: [{
          label: 'Cantidad de Solicitudes',
          data: topServices.map(s => s.count),
          backgroundColor: '#43e97b',
          borderColor: '#38f9d7',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        indexAxis: 'y',
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          x: {
            beginAtZero: true,
            ticks: { stepSize: 1 }
          }
        }
      }
    });
  }

  // Gráfico 3: Citas por Día (Última Semana)
  const ctx3 = document.getElementById('appointmentsWeekChart');
  if (ctx3) {
    const weekData = {};
    const today = new Date();
    
    for (let i = 6; i >= 0; i--) {
      const date = new Date(today);
      date.setDate(date.getDate() - i);
      const key = date.toLocaleDateString('es-ES', { weekday: 'short', day: '2-digit' });
      weekData[key] = 0;
    }

    appointments.forEach(a => {
      if (a.status === 'confirmada') {
        const apptDate = new Date(a.date);
        const key = apptDate.toLocaleDateString('es-ES', { weekday: 'short', day: '2-digit' });
        if (key in weekData) {
          weekData[key]++;
        }
      }
    });

    charts.appointmentsWeek = new Chart(ctx3, {
      type: 'line',
      data: {
        labels: Object.keys(weekData),
        datasets: [{
          label: 'Citas',
          data: Object.values(weekData),
          borderColor: '#4facfe',
          backgroundColor: 'rgba(79, 172, 254, 0.1)',
          borderWidth: 2,
          fill: true,
          tension: 0.4,
          pointBackgroundColor: '#4facfe',
          pointBorderColor: '#00f2fe',
          pointBorderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { stepSize: 1 }
          }
        }
      }
    });
  }

  // Gráfico 4: Ingresos Mensuales
  const ctx4 = document.getElementById('revenueMonthChart');
  if (ctx4) {
    const monthlyRevenue = {};
    const months = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
    months.forEach(m => monthlyRevenue[m] = 0);

    appointments.forEach(a => {
      if (a.status === 'confirmada') {
        const apptDate = new Date(a.date);
        const monthIndex = apptDate.getMonth();
        const revenue = (a.serviceIds || []).reduce((sum, sid) => {
          const service = services.find(s => s.id === sid);
          return sum + (service ? service.price : 0);
        }, 0);
        monthlyRevenue[months[monthIndex]] += revenue;
      }
    });

    charts.revenueMonth = new Chart(ctx4, {
      type: 'bar',
      data: {
        labels: months,
        datasets: [{
          label: 'Ingresos ($)',
          data: Object.values(monthlyRevenue),
          backgroundColor: '#f5576c',
          borderColor: '#f093fb',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });
  }
}

// === CARGA DE FOTO DE BARBERO ===
function handleBarberPhotoUpload(e) {
  const file = e.target.files[0];
  const maxSize = 5 * 1024 * 1024; // 5MB

  if (!file) return;

  if (file.size > maxSize) {
    showToast('Archivo demasiado grande. Máximo 5MB.', 'error');
    e.target.value = '';
    return;
  }

  if (!['image/jpeg', 'image/jpg'].includes(file.type)) {
    showToast('Solo se aceptan imágenes JPG/JPEG', 'error');
    e.target.value = '';
    return;
  }

  const reader = new FileReader();
  reader.onload = (event) => {
    const base64 = event.target.result;
    document.getElementById('barberPhotoBase64').value = base64;
    
    const preview = document.getElementById('barberPhotoPreview');
    preview.innerHTML = `
      <div class="text-center">
        <img src="${base64}" alt="Vista previa" style="max-width: 100%; max-height: 200px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <p class="text-muted mt-2 mb-0"><small>Nueva foto seleccionada</small></p>
      </div>
    `;

    const status = document.getElementById('barberPhotoStatus');
    status.innerHTML = '<i class="fas fa-check" style="color: var(--success);"></i>';
  };
  reader.readAsDataURL(file);
}

// === GUARDAR BARBERO ===
function saveBarber() {
  const name = document.getElementById('barberName').value.trim();
  const phone = document.getElementById('barberPhone').value.trim();
  const specialty = document.getElementById('barberSpecialty').value;
  const photoBase64 = document.getElementById('barberPhotoBase64').value;

  if (!name || !phone || !specialty) {
    showToast('Completa todos los campos obligatorios', 'error');
    return;
  }

  let barbers = JSON.parse(localStorage.getItem('loockingBarbers')) || [];

  if (editingBarberId) {
    const idx = barbers.findIndex(b => b.id === editingBarberId);
    if (idx !== -1) {
      barbers[idx] = {
        id: editingBarberId,
        name,
        phone,
        specialty,
        photo: photoBase64 || barbers[idx].photo
      };
    }
  } else {
    const newId = barbers.length ? Math.max(...barbers.map(b => b.id)) + 1 : 1;
    barbers.push({
      id: newId,
      name,
      phone,
      specialty,
      photo: photoBase64 || `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=c19b76&color=fff&size=400`
    });
  }

  localStorage.setItem('loockingBarbers', JSON.stringify(barbers));
  bootstrap.Modal.getInstance(document.getElementById('barberModal'))?.hide();
  editingBarberId = null;

  // Actualización inmediata
  triggerLocalUpdate('loockingBarbers');
  showToast('Personal guardado exitosamente', 'success');
}
