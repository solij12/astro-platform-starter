function confirmBooking() {
  const name = document.getElementById('clientName').value.trim();
  const phone = document.getElementById('clientPhone').value.trim();
  const email = document.getElementById('clientEmail').value.trim();
  const date = document.getElementById('bookingDate').value;
  const time = document.getElementById('bookingTime').value;
  
  if (!name || !phone || !email) {
    showToast('Completa los datos del cliente', 'error');
    return;
  }
  if (!date || !time) {
    showToast('Selecciona fecha y hora', 'error');
    return;
  }
  if (!selectedBarberId) {
    showToast('Selecciona personal', 'error');
    return;
  }
  if (selectedServices.length === 0) {
    showToast('Selecciona al menos un servicio', 'error');
    return;
  }

  const appointments = JSON.parse(localStorage.getItem('loockingAppointments')) || [];
  const conflict = appointments.find(a => 
    parseInt(a.barberId) === parseInt(selectedBarberId) && 
    a.date === date && 
    a.time === time
  );
  
  if (conflict) {
    showToast('La hora seleccionada ya está ocupada. Elige otra.', 'error');
    updateAvailableTimes();
    return;
  }

  let clients = JSON.parse(localStorage.getItem('loockingClients')) || [];
  let client = clients.find(c => c.email === email);
  
  if (!client) {
    client = {
      id: clients.length ? Math.max(...clients.map(c => c.id)) + 1 : 1,
      name, phone, email,
      createdAt: new Date().toISOString()
    };
    clients.push(client);
    localStorage.setItem('loockingClients', JSON.stringify(clients));
  }

  let appts = appointments;
  const newAppointment = {
    id: appts.length ? Math.max(...appts.map(a => a.id)) + 1 : 1,
    clientId: client.id,
    clientName: name,
    clientPhone: phone,
    clientEmail: email,
    barberId: selectedBarberId,
    serviceIds: selectedServices.slice(),
    date: date,
    time: time,
    status: 'confirmada',
    createdAt: new Date().toISOString()
  };
  appts.push(newAppointment);
  localStorage.setItem('loockingAppointments', JSON.stringify(appts));

  const barbers = JSON.parse(localStorage.getItem('loockingBarbers')) || [];
  const services = JSON.parse(localStorage.getItem('loockingServices')) || [];
  const barber = barbers.find(b => b.id === selectedBarberId);
  const servicesText = services
    .filter(s => newAppointment.serviceIds.includes(s.id))
    .map(s => s.name)
    .join(', ');

  const overlayData = {
    ...newAppointment,
    barberName: barber?.name || 'N/A',
    servicesText
  };

  showConfirmationOverlay(overlayData);
  updateDashboard();

  setTimeout(() => {
    selectedBarberId = null;
    selectedServices = [];
    selectedDate = null;
    currentStep = 1;
    
    document.getElementById('bookingDate').value = '';
    document.getElementById('bookingTime').value = '';
    document.getElementById('clientName').value = '';
    document.getElementById('clientPhone').value = '';
    document.getElementById('clientEmail').value = '';

    renderBookingServices();
    renderBookingBarbers();
    updateAvailableTimes();
    updateBookingSummary();

    document.querySelectorAll('.booking-form-step').forEach(s => s.style.display = 'none');
    document.querySelector('.booking-form-step[data-step="1"]').style.display = 'block';
    
    document.querySelectorAll('.booking-step').forEach((s, i) => {
      s.classList.remove('active', 'completed');
      if (i === 0) s.classList.add('active');
    });

    showToast('¡Cita agendada exitosamente!', 'success');
  }, 2000);
}

// === GESTIÓN DE CITAS (ADMIN) ===
function renderAppointments() {
  const appointments = JSON.parse(localStorage.getItem('loockingAppointments')) || [];
  const tbody = document.getElementById('appointmentsTbody');
  
  if (appointments.length === 0) {
    tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">No hay citas registradas</td></tr>';
    return;
  }

  const services = JSON.parse(localStorage.getItem('loockingServices')) || [];
  const barbers = JSON.parse(localStorage.getItem('loockingBarbers')) || [];

  tbody.innerHTML = '';
  appointments.forEach(a => {
    const barber = barbers.find(b => b.id === a.barberId);
    const serviceNames = (a.serviceIds || [])
      .map(id => {
        const service = services.find(s => s.id === id);
        return service ? service.name : '';
      })
      .filter(Boolean)
      .join(', ');

    const tr = document.createElement('tr');
    const statusBadgeClass = a.status === 'confirmada' ? 'success' : 'danger';
    const statusText = a.status.charAt(0).toUpperCase() + a.status.slice(1);
    
    tr.innerHTML = `
      <td>${a.clientName}</td>
      <td>${barber ? barber.name : 'N/A'}</td>
      <td>${new Date(a.date).toLocaleDateString('es-ES')}</td>
      <td>${a.time}</td>
      <td>${a.clientPhone || ''}</td>
      <td>
        <span class="badge bg-${statusBadgeClass}" id="badge-${a.id}">
          ${statusText}
        </span>
      </td>
      <td>
        <div class="btn-group btn-group-sm" role="group">
          ${a.status === 'confirmada' ? `
            <button class="btn btn-outline-warning" title="Cambiar a Cancelada" onclick="changeAppointmentStatus(${a.id}, 'cancelada')">
              <i class="fas fa-times"></i> Cancelar
            </button>
          ` : `
            <button class="btn btn-outline-success" title="Cambiar a Confirmada" onclick="changeAppointmentStatus(${a.id}, 'confirmada')">
              <i class="fas fa-check"></i> Confirmar
            </button>
          `}
          <button class="btn btn-outline-danger" title="Eliminar cita" onclick="deleteAppointment(${a.id})">
            <i class="fas fa-trash"></i>
          </button>
        </div>
      </td>
    `;
    
    tbody.appendChild(tr);
    
    if (serviceNames) {
      const serviceRow = document.createElement('tr');
      serviceRow.innerHTML = `<td colspan="7" class="text-muted small"><i class="fas fa-cut"></i> ${serviceNames}</td>`;
      tbody.appendChild(serviceRow);
    }
  });
}

// === CAMBIAR ESTADO DE CITA ===
function changeAppointmentStatus(appointmentId, newStatus) {
  const appointments = JSON.parse(localStorage.getItem('loockingAppointments')) || [];
  const appointment = appointments.find(a => a.id === appointmentId);
  
  if (!appointment) {
    showToast('Cita no encontrada', 'error');
    return;
  }

  const oldStatus = appointment.status;
  const statusMessage = newStatus === 'confirmada' ? 'confirmada' : 'cancelada';
  
  if (confirm(`¿Deseas cambiar el estado de la cita de ${appointment.clientName} a ${statusMessage}?`)) {
    appointment.status = newStatus;
    localStorage.setItem('loockingAppointments', JSON.stringify(appointments));
    
    // Actualizar vistas
    renderAppointments();
    updateDashboard();
    initDashboardCharts();
    renderRecentAppointments();
    
    const statusLabel = newStatus === 'confirmada' ? 'Confirmada' : 'Cancelada';
    showToast(`Cita de ${appointment.clientName} ${statusLabel.toLowerCase()}`, 'success');
  }
}

// === ELIMINAR CITA ===
function deleteAppointment(appointmentId) {
  const appointments = JSON.parse(localStorage.getItem('loockingAppointments')) || [];
  const appointment = appointments.find(a => a.id === appointmentId);
  
  if (!appointment) {
    showToast('Cita no encontrada', 'error');
    return;
  }

  if (confirm(`¿Deseas eliminar la cita de ${appointment.clientName} del ${new Date(appointment.date).toLocaleDateString('es-ES')} a las ${appointment.time}?`)) {
    let updatedAppointments = appointments.filter(a => a.id !== appointmentId);
    localStorage.setItem('loockingAppointments', JSON.stringify(updatedAppointments));
    
    // Actualizar vistas
    renderAppointments();
    updateDashboard();
    initDashboardCharts();
    renderRecentAppointments();
    
    showToast(`Cita de ${appointment.clientName} eliminada`, 'success');
  }
}

// === GESTIÓN DE CLIENTES (ADMIN) ===
function renderClients() {
  const clients = JSON.parse(localStorage.getItem('loockingClients')) || [];
  const tbody = document.getElementById('clientsTbody');
  
  if (!tbody) return;

  if (clients.length === 0) {
    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-4">No hay clientes registrados</td></tr>';
