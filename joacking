// === UTILIDADES ===
function showToast(message, type = 'info', duration = 3000) {
  const container = document.getElementById('toastContainer');
  if (!container) return;
  const div = document.createElement('div');
  div.className = `toast-message ${type}`;
  div.innerHTML = `<div>${message}</div>`;
  container.appendChild(div);
  setTimeout(() => {
    div.style.opacity = '0';
    setTimeout(() => {
      if (container.contains(div)) container.removeChild(div);
    }, 300);
  }, duration);
}

function pad(n) {
  return n < 10 ? '0' + n : '' + n;
}

function formatISOLocal(date) {
  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
}

function isSameDay(a, b) {
  return a.getFullYear() === b.getFullYear() &&
         a.getMonth() === b.getMonth() &&
         a.getDate() === b.getDate();
}

// Sidebar control helpers
function showSidebar() {
  const sidebar = document.getElementById('mainSidebar');
  const content = document.querySelector('.main-content');
  if (!sidebar || !content) return;
  sidebar.classList.remove('collapsed');
  content.classList.remove('sidebar-collapsed');
}

function hideSidebar() {
  const sidebar = document.getElementById('mainSidebar');
  const content = document.querySelector('.main-content');
  if (!sidebar || !content) return;
  sidebar.classList.add('collapsed');
  content.classList.add('sidebar-collapsed');
}

function toggleSidebar() {
  const sidebar = document.getElementById('mainSidebar');
  if (!sidebar) return;
  if (sidebar.classList.contains('collapsed')) {
    showSidebar();
  } else {
    hideSidebar();
  }
}

// === OBSERVADORES DE CAMBIOS ===
function setupStorageObservers() {
  // Observador para cambios en localStorage
  window.addEventListener('storage', (e) => {
    if (e.key === 'loockingBarbers' || e.key === 'loockingServices' || e.key === 'loockingAppointments') {
      refreshAllViews();
    }
  });
}

function refreshAllViews() {
  // Actualizar la vista actual
  const activeSection = document.querySelector('.page-section.active');
  if (!activeSection) return;

  const sectionId = activeSection.id;

  switch(sectionId) {
    case 'dashboard':
      updateDashboard();
      initDashboardCharts();
      break;
    case 'services':
      renderServices();
      break;
    case 'barbers':
      renderBarbers();
      break;
    case 'appointments':
      renderAppointments();
      break;
    case 'clients':
      renderClients();
      break;
    case 'clientView':
      renderBookingServices();
      renderBookingBarbers();
      break;
  }
}

// Función auxiliar para disparar actualizaciones locales
function triggerLocalUpdate(key) {
  if (key === 'loockingServices') {
    if (document.getElementById('servicesTbody')) renderServices();
    if (document.getElementById('bookingServicesContainer')) renderBookingServices();
    if (document.querySelector('.page-section.active#dashboard')) {
      initDashboardCharts();
      updateDashboard();
    }
  }
  if (key === 'loockingBarbers') {
    if (document.getElementById('barberGallery')) renderBarbers();
    if (document.getElementById('bookingBarbersContainer')) renderBookingBarbers();
    if (document.querySelector('.page-section.active#dashboard')) {
      initDashboardCharts();
      updateDashboard();
    }
  }
  if (key === 'loockingAppointments') {
    if (document.querySelector('.page-section.active#dashboard')) {
      updateDashboard();
      initDashboardCharts();
    }
    if (document.getElementById('appointmentsTbody')) renderAppointments();
    if (document.getElementById('recentAppointmentsTbody')) renderRecentAppointments();
  }
}

