function saveService() {
  const name = document.getElementById('serviceName').value.trim();
  const description = document.getElementById('serviceDescription').value.trim();
  const durationValue = document.getElementById('serviceDuration').value.trim();
  const priceValue = document.getElementById('servicePrice').value.trim();

  // Validaciones mejoradas
  if (!name) {
    showToast('Ingresa el nombre del servicio', 'error');
    document.getElementById('serviceName').focus();
    return;
  }

  if (!description) {
    showToast('Ingresa una descripción del servicio', 'error');
    document.getElementById('serviceDescription').focus();
    return;
  }

  if (!durationValue || isNaN(parseInt(durationValue)) || parseInt(durationValue) <= 0) {
    showToast('Ingresa una duración válida (en minutos)', 'error');
    document.getElementById('serviceDuration').focus();
    return;
  }

  if (!priceValue || isNaN(parseInt(priceValue)) || parseInt(priceValue) <= 0) {
    showToast('Ingresa un precio válido', 'error');
    document.getElementById('servicePrice').focus();
    return;
  }

  const duration = parseInt(durationValue);
  const price = parseInt(priceValue);

  let services = JSON.parse(localStorage.getItem('loockingServices')) || [];
  const isEditing = editingServiceId !== null;

  if (isEditing) {
    // Editar servicio existente
    const idx = services.findIndex(s => s.id === editingServiceId);
    if (idx !== -1) {
      services[idx] = { 
        id: editingServiceId, 
        name, 
        description, 
        duration, 
        price 
      };
      showToast('Servicio actualizado exitosamente', 'success');
    } else {
      showToast('No se encontró el servicio a editar', 'error');
      return;
    }
  } else {
    // Crear nuevo servicio
    const newId = services.length ? Math.max(...services.map(s => s.id)) + 1 : 1;
    services.push({ 
      id: newId, 
      name, 
      description, 
      duration, 
      price 
    });
    showToast('Servicio creado exitosamente', 'success');
  }

  // Guardar en localStorage
  localStorage.setItem('loockingServices', JSON.stringify(services));
  
  // Cerrar modal
  const modalElement = document.getElementById('serviceModal');
  const modalInstance = bootstrap.Modal.getInstance(modalElement);
  if (modalInstance) {
    modalInstance.hide();
  }

  // Limpiar variable de edición
  editingServiceId = null;

  // Limpiar formulario
  document.getElementById('serviceName').value = '';
  document.getElementById('serviceDescription').value = '';
  document.getElementById('serviceDuration').value = '';
  document.getElementById('servicePrice').value = '';
  document.getElementById('serviceModalLabel').textContent = 'Nuevo Servicio';

  // Actualizar vistas
  renderServices();
  renderBookingServices();
  updateDashboard();
  initDashboardCharts();
}

function editService(id) {
  const services = JSON.parse(localStorage.getItem('loockingServices')) || [];
  const service = services.find(s => s.id === id);

  if (!service) {
    showToast('No se encontró el servicio', 'error');
    return;
  }

  // Establecer variable global para saber que estamos editando
  editingServiceId = service.id;

  // Cargar datos en el formulario
  document.getElementById('serviceName').value = service.name;
  document.getElementById('serviceDescription').value = service.description;
  document.getElementById('serviceDuration').value = service.duration;
  document.getElementById('servicePrice').value = service.price;

  // Cambiar título del modal
  document.getElementById('serviceModalLabel').textContent = `Editar: ${service.name}`;

  // Cambiar texto del botón
  const saveBtn = document.getElementById('saveServiceBtn');
  saveBtn.textContent = 'Actualizar Servicio';

  // Mostrar modal
  const modalElement = document.getElementById('serviceModal');
  const modal = new bootstrap.Modal(modalElement);
  modal.show();
}

function deleteService(id) {
  const services = JSON.parse(localStorage.getItem('loockingServices')) || [];
  const service = services.find(s => s.id === id);

  if (!service) {
    showToast('No se encontró el servicio', 'error');
    return;
  }

  // Confirmación mejorada
  if (confirm(`¿Estás seguro de que deseas eliminar el servicio "${service.name}"? Esta acción no se puede deshacer.`)) {
    // Eliminar servicio
    let updatedServices = services.filter(s => s.id !== id);
    localStorage.setItem('loockingServices', JSON.stringify(updatedServices));

    // También eliminar referencias en citas
    let appointments = JSON.parse(localStorage.getItem('loockingAppointments')) || [];
    appointments.forEach(appt => {
      if (appt.serviceIds && appt.serviceIds.includes(id)) {
        appt.serviceIds = appt.serviceIds.filter(sId => sId !== id);
      }
    });
    localStorage.setItem('loockingAppointments', JSON.stringify(appointments));

    // Mostrar notificación
    showToast(`Servicio "${service.name}" eliminado exitosamente`, 'success');

    // Actualizar vistas
    renderServices();
    renderBookingServices();
    updateDashboard();
    initDashboardCharts();
  }
}

